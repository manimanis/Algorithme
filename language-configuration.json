{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["[", "]"],
    ["{", "}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^((?!\\/\\/).)*\\b([dD][eéEÉ][bB][uU][tT]|[aA][lL][oO][rR][sS]|[fF][aA][iI][rR][eE]|[rR][eéEÉ][pP][eéEÉ][tT][eE][rR]|[sS][iI][nN][oO][nN])\\b\\s*(?:\\/\\/.*)?$|^\\s*[sS][eE][lL][oO][nN]\\b.*$",
    "decreaseIndentPattern": "^\\s*([fF][iI][nN](\\s*([sS][iI]|[pP][oO][uU][rR]|[tT][aA][nN][tT]\\s*[qQ][uU][eE]|[sS][eE][lL][oO][nN]))?|[sS][iI][nN][oO][nN])\\b.*$|^\\s*[jJ][uU][sS][qQ][uU]['’]?[aàAÀ](?:\\s.*)?$"
  }
}
