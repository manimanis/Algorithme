{
  "Algorithme complet": {
    "prefix": "algorithme",
    "body": [
      "Algorithme ${1:NomAlgorithme}",
      "Début",
      "  ${0}",
      "Fin"
    ],
    "description": "Structure complète d'un algorithme"
  },
  "Si - Alors": {
    "prefix": "sisimple",
    "body": [
      "Si ${1:condition} Alors",
      "  ${2:instructions}",
      "Fin Si"
    ],
    "description": "Structure conditionnelle Si...Alors"
  },
  "Si - Alors - Sinon": {
    "prefix": "sicomplete",
    "body": [
      "Si ${1:condition} Alors",
      "  ${2:instructions}",
      "Sinon",
      "  ${3:instructions}",
      "Fin Si"
    ],
    "description": "Structure conditionnelle Si...Alors...Sinon"
  },
  "Si - Alors - Sinon Si - Alors - Sinon": {
    "prefix": "sigeneralisee",
    "body": [
      "Si ${1:condition} Alors",
      "  ${2:instructions}",
      "Sinon Si ${3:condition} Alors",
      "  ${4:instructions}",
      "Sinon",
      "  ${5:instructions}",
      "Fin Si"
    ],
    "description": "Structure conditionnelle Si...Alors...Sinon Si...Alors...Sinon"
  },
  "Tant Que": {
    "prefix": "tantque",
    "body": [
      "Tant Que ${1:condition} Faire",
      "  ${0:instructions}",
      "Fin Tant Que"
    ],
    "description": "Boucle Tant Que"
  },
  "Répéter - Jusqu'à": {
    "prefix": [
      "repeter",
      "répéter"
    ],
    "body": [
      "Répéter",
      "  ${0:instructions}",
      "Jusqu'à ${1:condition}"
    ],
    "description": "Boucle Répéter...Jusqu'à"
  },
  "Pour avec Pas": {
    "prefix": "pourpas",
    "body": [
      "Pour ${1:i} de ${2:1} à ${3:N} Faire [Pas=${4:1}]",
      "  ${0:instructions}",
      "Fin Pour"
    ],
    "description": "Boucle Pour"
  },
  "Pour": {
    "prefix": "pour",
    "body": [
      "Pour ${1:i} de ${2:1} à ${3:N} Faire",
      "  ${0:instructions}",
      "Fin Pour"
    ],
    "description": "Boucle Pour"
  },
  "Selon": {
    "prefix": "selon",
    "body": [
      "Selon ${1:variable} Faire",
      "  ${2:valeur1}: ${3:instructions}",
      "  ${4:valeur2}: ${5:instructions}",
      "  ${6:autrement}: ${7:instructions}",
      "Fin Selon"
    ],
    "description": "Structure conditionnelle Selon...Faire...Fin Selon"
  },
  "Procédure": {
    "prefix": "procedure",
    "body": [
      "Procédure ${1:NomProcedure}(${2:paramètres})",
      "Début",
      "  ${0:instructions}",
      "Fin"
    ],
    "description": "Définition d'une procédure"
  },
  "Fonction": {
    "prefix": "fonction",
    "body": [
      "Fonction ${1:NomFonction}(${2:paramètres}):${3:typeRetour}",
      "Début",
      "  ${0:instructions}",
      "  Retourner ${4:valeur}",
      "Fin"
    ],
    "description": "Définition d'une fonction"
  },
  "TDNT": {
    "prefix": "tdnt",
    "body": [
      "TDNT",
      "${1:NomTableau} = Tableau de ${2:taille} ${3:type}"
    ],
    "description": "Instruction de retour"
  },
  "TDO": {
    "prefix": "tdo",
    "body": [
      "TDO",
      "Objet : Type/Nature",
      "${1:var} : ${2:type}"
    ],
    "description": "Instruction de retour"
  },
  "Tableau": {
    "prefix": "tableau",
    "body": [
      "${1:NomTableau} = Tableau de ${2:taille} ${3:type}"
    ],
    "description": "Déclaration d'un tableau"
  },
  "Lire": {
    "prefix": "lire",
    "body": [
      "Lire(${1:variable})"
    ],
    "description": "Instruction de lecture"
  },
  "Ecrire": {
    "prefix": "ecrire",
    "body": [
      "Ecrire(${1:message})"
    ],
    "description": "Instruction d'écriture"
  },
  "Si avec opérateur ∈": {
    "prefix": "appartient",
    "body": [
      "Si ${1:valeur} ∈ ${2:tableau} Alors",
      "  ${0:instructions}",
      "Fin Si"
    ],
    "description": "Condition avec appartenance à un tableau"
  },
  "Déclaration variable": {
    "prefix": "var",
    "body": [
      "${1:nom} : ${2|entier,réel,caractère,chaine,booléen|}"
    ],
    "description": "Déclaration d'une variable"
  },
  "Affectation": {
    "prefix": "affectation",
    "body": [
      "${1:variable} ← ${2:valeur}"
    ],
    "description": "Opérateur d'affectation"
  },
  "incrementer": {
    "prefix": "incrementer",
    "body": [
      "${1:variable} ← ${1:variable} + ${2|1|}"
    ],
    "description": "Opérateur d'incrémentation"
  },
  "decrementer": {
    "prefix": "decrementer",
    "body": [
      "${1:variable} ← ${1:variable} - ${2|1|}"
    ],
    "description": "Opérateur de décrémentation"
  },
  "Saisir": {
    "prefix": "saisir",
    "body": [
      "Procédure Saisir(@${1:n}: entier)",
      "Début",
      "  Répéter",
      "    Ecrire(\"Entrez ${1:n} ? \")",
      "    Lire(${1:n})",
      "  Jusqu'à ${2:valeurMin} ≤ ${1:n} ≤ ${3:valeurMax}",
      "Fin"
    ],
    "description": "Instruction de saisie"
  },
  "Remplir": {
    "prefix": "remplir",
    "body": [
      "Procédure Remplir(@${1:t}: ${2:Tab}, ${3:n}: entier)",
      "Début",
      "  Pour i de 0 à ${3:n} - 1 Faire",
      "    Ecrire(\"Entrez ${1:t}[\", ${i}, \"] ? \")",
      "    Lire(${1:t}[${i}])",
      "  Fin Pour",
      "Fin"
    ],
    "description": "Instruction de remplissage d'un tableau"
  },
  "Afficher": {
    "prefix": "afficher",
    "body": [
      "Procédure Afficher(${1:t}: ${2:Tab}, ${3:n}: entier)",
      "Début",
      "  Pour i de 0 à ${3:n} - 1 Faire",
      "    Ecrire(${1:t}[${i}])",
      "  Fin Pour",
      "Fin"
    ],
    "description": "Instruction d'affichage d'un tableau"
  },
  "tribulles": {
    "prefix": "tribulles",
    "body": [
      "Procédure TriBulles(@${1:t}: ${2:Tab}, ${3:n}: entier)",
      "Début",
      "  Répéter",
      "    ${4:trié} ← Vrai",
      "    Pour i de 0 à ${3:n} - 2 Faire",
      "      Si ${1:t}[${i}] > ${1:t}[${i + 1}] Alors",
      "        // Échange des éléments",
      "        aux ← ${1:t}[${i}]",
      "        ${1:t}[${i}] ← ${1:t}[${i + 1}]",
      "        ${1:t}[${i + 1}] ← aux",
      "        ${4:trié} ← Faux",
      "      Fin Si",
      "    Fin Pour",
      "  Jusqu'à ${4:trié}",
      "Fin"
    ],
    "description": "Procedure de tri bulle"
  },
  "triselection": {
    "prefix": "triselection",
    "body": [
      "Procédure TriSelection(@${1:t}: ${2:Tab}, ${3:n}: entier)",
      "Début",
      "  Pour i de 0 à ${3:n} - 2 Faire",
      "    min ← i",
      "    Pour j de i + 1 à ${3:n} - 1 Faire",
      "      Si ${1:t}[j] < ${1:t}[min] Alors",
      "        min ← j",
      "      Fin Si",
      "    Fin Pour",
      "    Si min ≠ i Alors",
      "      // Échange des éléments",
      "      aux ← ${1:t}[i]",
      "      ${1:t}[i] ← ${1:t}[min]",
      "      ${1:t}[min] ← aux",
      "    Fin Si",
      "  Fin Pour",
      "Fin"
    ],
    "description": "Procedure de tri par sélection"
  },
  "triinsertion": {
    "prefix": "triinsertion",
    "body": [
      "Procédure TriInsertion(@${1:t}: ${2:Tab}, ${3:n}: entier)",
      "Début",
      "  Pour i de 1 à ${3:n} - 1 Faire",
      "    x ← ${1:t}[i]",
      "    j ← i",
      "    Tant que j > 0 et ${1:t}[j - 1] > x Faire",
      "      ${1:t}[j] ← ${1:t}[j - 1]",
      "      j ← j - 1",
      "    Fin Tant que",
      "    ${1:t}[j] ← x",
      "  Fin Pour",
      "Fin"
    ],
    "description": "Procedure de tri par insertion"
  },
  "rechercher": {
    "prefix": "rechercher",
    "body": [
      "Fonction Rechercher(${4:v}: ${5:entier}, ${1:t}: ${2:Tab}, ${3:n}: entier):entier",
      "Début",
      "  p ← -1",
      "  Tant que p = -1 et i < ${3:n} Faire",
      "    Si ${1:t}[i] = ${4:v} Alors",
      "      p ← i",
      "    Fin Si",
      "    i ← i + 1",
      "  Fin Tant que",
      "  Retourner p",
      "Fin"
    ],
    "description": "Fonction de recherche"
  },
  "verif": {
    "prefix": "verif",
    "body": [
      "Fonction Verif(${1:ch}: ${2:chaîne}):booleen",
      "Début",
      "  test ← Long(ch) > 0",
      "  i ← 0",
      "  Tant que test et i < Long(ch) Faire",
      "    test ← \"A\" ≤ Majus(${1:ch}[i]) ≤ \"Z\"",
      "    i ← i + 1",
      "  Fin Tant que",
      "  Retourner test",
      "Fin"
    ],
    "description": "Fonction de vérification"
  },
  "Enregistrement (TDNT)": {
    "prefix": [
      "enreg_tdnt",
      "enregistrement_tdnt"
    ],
    "body": [
      "${1:TypeEnreg} = Enregistrement",
      "  ${2:champ1} : ${3:entier}",
      "  ${4:champ2} : ${5:chaîne}",
      "Fin"
    ],
    "description": "Déclaration d'un type Enregistrement dans le TDNT"
  },
  "Enregistrement direct (TDO)": {
    "prefix": [
      "enreg_tdo",
      "enregistrement_tdo"
    ],
    "body": [
      "${1:art} : Enregistrement",
      "  ${2:champ1} : ${3:entier}",
      "  ${4:champ2} : ${5:chaîne}",
      "Fin"
    ],
    "description": "Déclaration directe d'un Enregistrement dans le TDO"
  },
  "Tableau d'enregistrements (TDNT)": {
    "prefix": [
      "tab_enreg",
      "tableau_enregistrements"
    ],
    "body": [
      "${1:Tab} = Tableau de ${2:50} ${3:TypeEnreg}"
    ],
    "description": "Déclaration d'un tableau d'enregistrements"
  },
  "Matrice (TDNT)": {
    "prefix": [
      "matrice_tdnt",
      "mat_tdnt"
    ],
    "body": [
      "${1:Mat} = Tableau de ${2:3} lignes * ${3:3} colonnes ${4:entier}"
    ],
    "description": "Déclaration d'un type Matrice (2D) dans le TDNT"
  },
  "Matrice (TDO)": {
    "prefix": [
      "matrice_tdo",
      "mat_tdo"
    ],
    "body": [
      "${1:M} : Tableau de ${2:3} lignes * ${3:3} colonnes ${4:entier}"
    ],
    "description": "Déclaration d'une variable Matrice (2D) dans le TDO"
  },
  "Parcours d'une Matrice": {
    "prefix": [
      "parcours_matrice",
      "pour_matrice"
    ],
    "body": [
      "Pour ${1:i} De 0 A ${2:nl - 1} Faire",
      "  Pour ${3:j} De 0 A ${4:nc - 1} Faire",
      "    ${5:M[i, j] ← ...}",
      "  Fin Pour",
      "Fin Pour"
    ],
    "description": "Parcours complet des cases d'une matrice avec deux boucles imbriquées"
  },
  "Fichier Texte (Lecture ligne par ligne)": {
    "prefix": [
      "fich_lire_texte",
      "fichier_texte_lecture"
    ],
    "body": [
      "Ouvrir(\"${1:fichier.txt}\", ${2:f}, \"r\")",
      "Tant Que Non Fin_fichier(${2:f}) Faire",
      "  Lire_ligne(${2:f}, ${3:ligne})",
      "  ${4:// Traitement de la ligne}",
      "Fin Tant Que",
      "Fermer(${2:f})"
    ],
    "description": "Ouverture, lecture ligne par ligne et fermeture d'un fichier texte"
  },
  "Fichier Texte (Écriture)": {
    "prefix": [
      "fich_ecrire_texte",
      "fichier_texte_ecriture"
    ],
    "body": [
      "Ouvrir(\"${1:fichier.txt}\", ${2:f}, \"w\")",
      "Ecrire_nl(${2:f}, ${3:ligne})",
      "Fermer(${2:f})"
    ],
    "description": "Ouverture en écriture d'un fichier texte et ajout de ligne"
  },
  "Fichier Données Typé (Lecture)": {
    "prefix": [
      "fich_lire_data",
      "fichier_donnees_lecture"
    ],
    "body": [
      "Ouvrir(\"${1:donnees.dat}\", ${2:f}, \"rb\")",
      "Tant Que Non Fin_fichier(${2:f}) Faire",
      "  Lire(${2:f}, ${3:val})",
      "  ${4:// Traitement}",
      "Fin Tant Que",
      "Fermer(${2:f})"
    ],
    "description": "Lecture séquentielle d'un fichier de données typé"
  },
  "Fichier Données Typé (Écriture)": {
    "prefix": [
      "fich_ecrire_data",
      "fichier_donnees_ecriture"
    ],
    "body": [
      "Ouvrir(\"${1:donnees.dat}\", ${2:f}, \"wb\")",
      "Ecrire(${2:f}, ${3:val})",
      "Fermer(${2:f})"
    ],
    "description": "Écriture dans un fichier de données typé"
  }
}