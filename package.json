{
  "name": "tunisian-algorithms-highlighter",
  "displayName": "Extension pour l'Algorithme Tunisien",
  "description": "Syntax highlighting, operator auto-replacement and preview with TDO/TDNT tables for the Algorithme language",
  "version": "2.0.4",
  "publisher": "mohamedanismani",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.65.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:algorithme",
    "onCommand:algorithme.run",
    "onCommand:algorithme.compileExe",
    "onCommand:algorithme.toPython",
    "onCommand:algorithme.showPreview",
    "onCommand:algorithme.generateTDO",
    "onCommand:algorithme.createExamTemplate",
    "onCommand:algorithme.checkBacCompliance"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "algorithme.run",
        "title": "Algorithme : Interpréter l'algorithme",
        "shortTitle": "Interpréter l'algorithme",
        "icon": "$(play)"
      },
      {
        "command": "algorithme.compileExe",
        "title": "Algorithme : Compiler en exécutable",
        "shortTitle": "Compiler en exécutable",
        "icon": "$(gear)"
      },
      {
        "command": "algorithme.toPython",
        "title": "Algorithme : Transpiler en Python",
        "shortTitle": "Transpiler en Python",
        "icon": "$(file-code)"
      },
      {
        "command": "algorithme.showPreview",
        "title": "Algorithme : Ouvrir l'aperçu (avec tableaux TDO/TDNT)",
        "shortTitle": "Aperçu",
        "icon": "$(open-preview)"
      },
      {
        "command": "algorithme.generateTDO",
        "title": "Algorithme : Générer / Mettre à jour le TDO",
        "shortTitle": "Générer / Compléter le TDO",
        "icon": "$(table)"
      },
      {
        "command": "algorithme.checkBacCompliance",
        "title": "Algorithme : Vérifier la conformité Baccalauréat",
        "shortTitle": "Vérification Bac",
        "icon": "$(pass)"
      },
      {
        "command": "algorithme.createExamTemplate",
        "title": "Algorithme : Créer un modèle de Devoir / Examen",
        "shortTitle": "Nouveau modèle de Devoir",
        "icon": "$(file-text)"
      }
    ],
    "submenus": [
      {
        "id": "algorithme.toolsSubmenu",
        "label": "Algorithme",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "algorithme.showPreview",
          "when": "editorLangId == algorithme",
          "group": "navigation@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "algorithme.run",
          "when": "editorLangId == algorithme",
          "group": "navigation@1"
        },
        {
          "command": "algorithme.compileExe",
          "when": "editorLangId == algorithme",
          "group": "navigation@2"
        },
        {
          "command": "algorithme.toPython",
          "when": "editorLangId == algorithme",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "algorithme.toolsSubmenu",
          "when": "editorLangId == algorithme",
          "group": "1_modification@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "algorithme.toolsSubmenu",
          "when": "resourceExtname == .alg || resourceExtname == .algo || resourceExtname == .algorithme",
          "group": "navigation@1"
        }
      ],
      "algorithme.toolsSubmenu": [
        {
          "command": "algorithme.run",
          "group": "1_tools@1"
        },
        {
          "command": "algorithme.compileExe",
          "group": "1_tools@2"
        },
        {
          "command": "algorithme.toPython",
          "group": "1_tools@3"
        },
        {
          "command": "algorithme.generateTDO",
          "group": "2_assistant@1"
        },
        {
          "command": "algorithme.checkBacCompliance",
          "group": "2_assistant@2"
        },
        {
          "command": "algorithme.showPreview",
          "group": "3_preview@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "algorithme.run",
        "key": "f5",
        "when": "editorLangId == algorithme"
      },
      {
        "command": "algorithme.compileExe",
        "key": "ctrl+f5",
        "when": "editorLangId == algorithme"
      },
      {
        "command": "algorithme.toPython",
        "key": "shift+f5",
        "when": "editorLangId == algorithme"
      },
      {
        "command": "algorithme.checkBacCompliance",
        "key": "f7",
        "when": "editorLangId == algorithme"
      },
      {
        "command": "algorithme.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == algorithme"
      }
    ],
    "configuration": {
      "title": "Algorithme",
      "properties": {
        "algorithme.interpreterPath": {
          "type": "string",
          "default": "C:\\xampp-school\\htdocs\\MesProjets\\AlgorithmCompiler\\algo.exe",
          "description": "Chemin complet vers l'exécutable de l'interpréteur / compilateur d'algorithmes (algo.exe)."
        }
      }
    },
    "configurationDefaults": {
      "[algorithme]": {
        "editor.tabSize": 2,
        "editor.indentSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.useTabStops": false
      }
    },
    "languages": [
      {
        "id": "algorithme",
        "aliases": [
          "Algorithme",
          "algorithme"
        ],
        "extensions": [
          ".alg",
          ".algo",
          ".algorithme"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "algorithme",
        "scopeName": "source.algorithme",
        "path": "./syntaxes/algorithme.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "algorithme",
        "path": "./snippets/algorithme.code-snippets.json"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "arithmetic",
        "description": "Arithmetic operator (+, -, *, /, div, mod)"
      },
      {
        "id": "comparison",
        "description": "Comparison operator (>, <, >=, <=, =, ≠, ∈)"
      },
      {
        "id": "assignment",
        "description": "Assignment operator (←)"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "operator": [
            "keyword.operator.algorithme"
          ]
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "operator",
        "superType": "operator",
        "description": "Operators in Algorithme"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manimanis/Algorithme"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.60.0",
    "typescript": "^5.0.0"
  }
}